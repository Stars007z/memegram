<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingTop="@dimen/_12sdp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGallery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnOpenFileSystem"
        android:layout_marginBottom="@dimen/_6sdp"/>

    <!-- Telegram-style Fast Scroller с датой -->
    <LinearLayout
        android:id="@+id/layoutFastScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="@dimen/_4sdp"
        android:elevation="@dimen/_8sdp"
        android:alpha="0"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvDateIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_search_bg"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:text="January 2026"
            android:textColor="#000000"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/_6sdp"/>

        <View
            android:id="@+id/scrollbarThumb"
            android:layout_width="@dimen/_4sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/rounded_search_bg"
            android:backgroundTint="#8E8E93"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnOpenFileSystem"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_40sdp"
        android:background="#F5F5F5"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_attachment"
            app:tint="#007AFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select from Files"
            android:textColor="#007AFF"
            android:textSize="@dimen/_14ssp"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/_6sdp"/>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnConfirmSelection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check"
        android:backgroundTint="#4CAF50"
        app:tint="#FFFFFF"
        android:layout_margin="@dimen/_12sdp"
        app:layout_constraintBottom_toTopOf="@id/btnOpenFileSystem"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
