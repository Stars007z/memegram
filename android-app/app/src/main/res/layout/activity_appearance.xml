<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_20sdp">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingVertical="@dimen/_12sdp"
            android:background="#D1D1D6"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/circle_gray_bg"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:padding="@dimen/_6sdp"
                android:scaleType="fitCenter"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:text="Appearance"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_200sdp"
            android:layout_margin="@dimen/_16sdp"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardElevation="@dimen/_4sdp">

            <RelativeLayout
                android:id="@+id/previewContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF">

                <View
                    android:id="@+id/previewTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:background="#D1D1D6"
                    android:layout_alignParentTop="true" />

                <ImageView
                    android:id="@+id/ivPreviewAvatar"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_below="@id/previewTopBar"
                    android:layout_margin="@dimen/_12sdp"
                    android:src="@drawable/ic_launcher_background" />

                <TextView
                    android:id="@+id/tvPreviewMessageIncoming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/ivPreviewAvatar"
                    android:layout_below="@id/previewTopBar"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:background="@drawable/rounded_search_bg"
                    android:padding="@dimen/_8sdp"
                    android:text="Привет! Как дела?"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/tvPreviewMessageOutgoing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_below="@id/tvPreviewMessageIncoming"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:background="@drawable/rounded_white"
                    android:backgroundTint="#007AFF"
                    android:padding="@dimen/_8sdp"
                    android:text="Ты кто?"
                    android:textColor="#FFFFFF" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp"
            android:text="Customize Colors"
            android:textStyle="bold"
            android:textSize="@dimen/_16ssp"
            android:textColor="#000000" />

        <!-- Status Bar item removed -->

        <include
            android:id="@+id/itemTopBar"
            layout="@layout/item_appearance_setting" />

        <include
            android:id="@+id/itemChatBg"
            layout="@layout/item_appearance_setting" />

        <include
            android:id="@+id/itemMyMessage"
            layout="@layout/item_appearance_setting" />

        <include
            android:id="@+id/itemTheirMessage"
            layout="@layout/item_appearance_setting" />

    </LinearLayout>
</ScrollView>
