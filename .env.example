# ─────────────────────────────────────────
# General
# ─────────────────────────────────────────
ENVIRONMENT=development
SERVICE_VERSION=1.0.0

# ─────────────────────────────────────────
# Auth Service
# ─────────────────────────────────────────
AUTH_DB_USER=memegram
AUTH_DB_PASSWORD=changeme
AUTH_DB_NAME=auth_db
JWT_SECRET=super_secret_jwt_key_change_me_in_prod

# ─────────────────────────────────────────
# User Service
# ─────────────────────────────────────────
USER_DB_USER=memegram
USER_DB_PASSWORD=changeme
USER_DB_NAME=user_db

# ─────────────────────────────────────────
# Contacts Service
# ─────────────────────────────────────────
CONTACTS_DB_USER=memegram
CONTACTS_DB_PASSWORD=changeme
CONTACTS_DB_NAME=contacts_db

# ─────────────────────────────────────────
# Messaging Service
# ─────────────────────────────────────────
MESSAGING_DB_USER=memegram
MESSAGING_DB_PASSWORD=changeme
MESSAGING_DB_NAME=messaging_db

# ─────────────────────────────────────────
# Media Service
# ─────────────────────────────────────────
MEDIA_DB_USER=memegram
MEDIA_DB_PASSWORD=changeme
MEDIA_DB_NAME=media_db
PRESIGNED_UPLOAD_TTL=3600
PRESIGNED_DOWNLOAD_TTL=900
MAX_UPLOAD_SIZE_BYTES=104857600

# ─────────────────────────────────────────
# Item Storage Service
# ─────────────────────────────────────────
ITEM_STORAGE_DB_USER=memegram
ITEM_STORAGE_DB_PASSWORD=changeme
ITEM_STORAGE_DB_NAME=item_storage_db
PENDING_CLEANUP_AFTER_SECONDS=7200

# ─────────────────────────────────────────
# Notifications Service
# ─────────────────────────────────────────
NOTIFICATIONS_DB_USER=memegram
NOTIFICATIONS_DB_PASSWORD=changeme
NOTIFICATIONS_DB_NAME=notifications_db

# ─────────────────────────────────────────
# AWS S3 (shared credentials for media-service & item-storage-service)
# ─────────────────────────────────────────
# IAM user access key (one user, two buckets)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-central-1

# Bucket for media-service (chat attachments, E2E encrypted)
S3_BUCKET_NAME=memegram-media

# Bucket for item-storage-service (avatars, backgrounds, sounds)
ITEM_STORAGE_S3_BUCKET=memegram-items

# Leave empty for real AWS S3. Set to http://minio:9000 for local MinIO dev.
S3_ENDPOINT_URL=

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://your-domain.com"]
