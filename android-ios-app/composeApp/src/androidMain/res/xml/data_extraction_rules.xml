<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup / D2D transfer rules. See backup_rules.xml for the
    legacy (Auto Backup) version. Same rationale: anything encrypted with the
    AndroidKeyStore master key cannot be migrated.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="key_manager_secure_prefs.xml" />
        <exclude domain="sharedpref" path="db_secure_prefs.xml" />
        <exclude domain="sharedpref" path="session_secure_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_keyset__.xml" />
        <exclude domain="database" path="memegram.db" />
        <exclude domain="database" path="memegram.db-journal" />
        <exclude domain="database" path="memegram.db-shm" />
        <exclude domain="database" path="memegram.db-wal" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="key_manager_secure_prefs.xml" />
        <exclude domain="sharedpref" path="db_secure_prefs.xml" />
        <exclude domain="sharedpref" path="session_secure_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_keyset__.xml" />
        <exclude domain="database" path="memegram.db" />
        <exclude domain="database" path="memegram.db-journal" />
        <exclude domain="database" path="memegram.db-shm" />
        <exclude domain="database" path="memegram.db-wal" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
