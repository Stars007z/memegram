<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"
        android:minHeight="@dimen/_50sdp"
        android:background="#D1D1D6">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_arrow_back"
            android:padding="@dimen/_6sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#000000"/>

        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:src="@drawable/circle_gray_bg"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_10sdp"
            android:text="User Name"
            android:textSize="@dimen/_16ssp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_menu"
            android:padding="@dimen/_6sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#000000"/>
    </LinearLayout>

    <!-- Chat Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/_8sdp"
        android:clipToPadding="false"
        android:background="#FFFFFF" />

    <!-- Attachments Preview -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttachedFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_8sdp"
        android:background="#F0F0F0"
        android:visibility="gone" />

    <include
        android:id="@+id/layoutSearchBar"
        layout="@layout/layout_search_bar" />

    <!-- Bottom Input Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottomInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_8sdp"
        android:background="#F0F0F0">

        <!-- Lock Hint (Hidden) -->
        <LinearLayout
            android:id="@+id/layoutLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:paddingBottom="@dimen/_24sdp"
            android:translationY="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@id/btnVoice"
            app:layout_constraintEnd_toEndOf="@id/btnVoice"
            app:layout_constraintStart_toStartOf="@id/btnVoice">

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/ic_arrow_back"
                android:rotation="90"
                app:tint="#8E8E93"/>

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="4dp"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="#8E8E93"/>
        </LinearLayout>

        <!-- Emoji -->
        <ImageView
            android:id="@+id/btnEmoji"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@drawable/ic_emoji"
            android:padding="@dimen/_6sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="2dp"/>

        <!-- Input Field -->
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:hint="Message"
            android:background="@drawable/rounded_search_bg"
            android:padding="@dimen/_10sdp"
            android:maxLines="6"
            android:textSize="@dimen/_14ssp"
            android:textColor="#000000"
            android:textColorHint="#8E8E93"
            app:layout_constraintStart_toEndOf="@id/btnEmoji"
            app:layout_constraintEnd_toStartOf="@id/btnAttach"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0"/>

        <!-- Attach -->
        <ImageView
            android:id="@+id/btnAttach"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:src="@drawable/ic_attachment"
            android:padding="@dimen/_6sdp"
            android:rotation="45"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toStartOf="@id/btnVoice"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="2dp"/>

        <!-- Recording UI (Overlay) -->
        <LinearLayout
            android:id="@+id/layoutRecording"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:background="#F0F0F0"
            android:paddingStart="@dimen/_12sdp"
            android:elevation="4dp"
            app:layout_constraintStart_toEndOf="@id/btnEmoji"
            app:layout_constraintEnd_toStartOf="@id/btnVoice"
            app:layout_constraintTop_toTopOf="@id/etMessage"
            app:layout_constraintBottom_toBottomOf="@id/etMessage">

            <ImageView
                android:id="@+id/ivRecIndicator"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:src="@drawable/circle_green_bg"
                app:tint="#FF3B30" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="0:00"
                android:textSize="@dimen/_16ssp"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/tvSlideToCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="&lt; Slide to cancel"
                android:textColor="#8E8E93"
                android:textSize="@dimen/_14ssp"/>
        </LinearLayout>

        <!-- Voice/Send Button -->
        <ImageView
            android:id="@+id/btnVoice"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:padding="@dimen/_6sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="2dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
